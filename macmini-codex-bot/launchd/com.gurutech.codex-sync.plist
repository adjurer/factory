<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.gurutech.codex-sync
  새 글감(feed) → Codex 초안(output/{id}/) → drafts/{id}/ 커밋·푸시. 30분마다 1회.

  설치:
    bash setup_macmini.sh            # 원클릭(권장)
    또는 수동:
    BOT="$HOME/factory/macmini-codex-bot"
    sed -e "s|__BOT_DIR__|$BOT|g" -e "s|__PYTHON__|/usr/bin/python3|g" launchd/com.gurutech.codex-sync.plist \
      > ~/Library/LaunchAgents/com.gurutech.codex-sync.plist
    plutil -lint ~/Library/LaunchAgents/com.gurutech.codex-sync.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.gurutech.codex-sync.plist

  즉시 1회 실행:
    launchctl kickstart -k gui/$(id -u)/com.gurutech.codex-sync

  해제:
    launchctl bootout gui/$(id -u)/com.gurutech.codex-sync
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gurutech.codex-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>cd "__BOT_DIR__" &amp;&amp; mkdir -p logs output state &amp;&amp; __PYTHON__ scripts/codex_sync.py --run-codex >> logs/codex-sync.log 2&gt;&amp;1</string>
    </array>

    <!-- 30분마다. 글감은 하루 3~4세트라 이 정도면 충분합니다. -->
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <true/>

    <key>WorkingDirectory</key>
    <string>__BOT_DIR__</string>

    <!-- codex·node·git을 찾을 수 있도록 PATH 지정 (Apple Silicon: /opt/homebrew/bin) -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__BOT_DIR__/logs/codex-sync.out.log</string>
    <key>StandardErrorPath</key>
    <string>__BOT_DIR__/logs/codex-sync.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>10</integer>
</dict>
</plist>
