# macmini-codex-bot 환경변수 — 이 파일을 `.env` 로 복사해서 채우세요.
#   cp .env.example .env
#   값이 비어 있어도 스크립트는 정상 동작하며, 해당 기능만 건너뜁니다.
# ⚠️ `.env` 는 .gitignore 대상입니다. 실제 값을 이 파일에 직접 적지 마세요(이 파일은 공개 저장소에 올라갑니다).

# ── 쿠팡 파트너스 Open API (쿠팡 파트너스 > 도구 > Open API 관리)
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
# 링크에 붙는 추적용 subId (예: gurutech). 비워도 됩니다.
COUPANG_SUB_ID=gurutech

# ── 알림 채널 (원하는 것만 채우세요. 여러 개면 모두 전송)
# 텔레그램: @BotFather 에서 봇 생성 → 토큰, 채팅 ID는 getUpdates 로 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 디스코드: 채널 설정 > 연동 > 웹훅 URL
DISCORD_WEBHOOK_URL=
# X: 자체 웹훅이 없습니다. Zapier / Make / n8n 릴레이 URL을 넣으면 {"text": "..."} 로 넘깁니다.
X_WEBHOOK_URL=

# ── 동작 스위치 (1 = 켜짐)
# 핫딜 레이더를 항상 미리보기 모드로 (알림 안 보냄)
HOTDEAL_DRY_RUN=0
# 코덱스 동기화를 항상 초안만 생성하도록
CODEX_SYNC_DRY_RUN=0

# ── Codex CLI 실행 명령 (기본: codex exec --skip-git-repo-check --color never "<프롬프트>")
# 프롬프트를 넣을 자리에 {} 를 쓸 수 있습니다.
# CODEX_CMD=codex exec --skip-git-repo-check --color never {}
